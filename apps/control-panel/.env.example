# Public browser configuration; these are not secrets.
# Use the separate platform-operator Cognito app client with authorization-code PKCE and MFA.
VITE_OPERATOR_AUTH_DOMAIN=https://replace-with-operator-login-domain.auth.ap-south-1.amazoncognito.com
VITE_OPERATOR_CLIENT_ID=replacewithpublicclientid
VITE_OPERATOR_REDIRECT_URI=https://replace-with-control-origin.example/control/callback
VITE_OPERATOR_LOGOUT_URI=https://replace-with-control-origin.example/control/

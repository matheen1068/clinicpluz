# Set this to the actual registered domain before a production build.
# Staging can use its own suffix, for example staging.example.com.
VITE_CLINIC_BASE_DOMAIN=clinicpluz.com

# Development only: Vite forwards same-origin /api requests to this backend.
# The backend must accept and validate the original goodwell.localhost Host.
CLINIC_API_PROXY_TARGET=http://127.0.0.1:8787

# Set this only after registering the domain. Staging can use a separate suffix.
# Example: VITE_CLINIC_BASE_DOMAIN=clinicpluz.example

# For a domain-free static demo, set this to the exact CloudFront default hostname.
# Example: VITE_DEMO_HOSTNAME=d123456abcdef.cloudfront.net
# This enables /clinic/<slug>/login/ but never provides authentication on its own.

# Development only: Vite forwards same-origin /api requests to this backend.
# The backend must accept and validate the original goodwell.localhost Host.
CLINIC_API_PROXY_TARGET=http://127.0.0.1:8787
